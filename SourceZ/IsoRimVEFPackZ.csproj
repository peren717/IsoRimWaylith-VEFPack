<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pack's IsoRimZ part, loaded only with IsoRimZ active (LoadFolders.xml: 1.7/IsoRimZ): VEF PipeSystem pipes across
       floors. ProjectZ: public ProjectZ.Api only (Api 3); override with -p:ProjectZDll=<path> to build against a worktree.
       IsoRim: public IsoRim.Api only (SpriteColour, Api 8); override with -p:IsoRimDll=<path>.
       VEF: PipeSystem.dll (public types; one private method patched by name, fail-soft). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRimWaylith_VEFPackZ</AssemblyName>
    <RootNamespace>IsoRimVEFPackZ</RootNamespace>
    <OutputPath>..\1.7\IsoRimZ\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
    <RimDir Condition="'$(RimDir)' == ''">..\..\..</RimDir>
    <ProjectZDll Condition="'$(ProjectZDll)' == ''">..\..\IsoRimProjectZ\1.7\Assemblies\IsoRimProjectZ.dll</ProjectZDll>
    <IsoRimDll Condition="'$(IsoRimDll)' == ''">..\..\IsoRim17\1.7\Assemblies\IsoRim.dll</IsoRimDll>
    <PipeSystemDll Condition="'$(PipeSystemDll)' == ''">$(RimDir)\..\..\workshop\content\294100\2023507013\1.7\Assemblies\PipeSystem.dll</PipeSystemDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RimDir)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRimProjectZ"><HintPath>$(ProjectZDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRim"><HintPath>$(IsoRimDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="PipeSystem"><HintPath>$(PipeSystemDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
